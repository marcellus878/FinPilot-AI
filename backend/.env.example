# FinPilot AI Backend Environment Configuration
PROJECT_NAME="FinPilot AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_here"
POSTGRES_DB="finpilot"
# DATABASE_URL="postgresql://postgres:postgres_password_here@localhost:5432/finpilot"

# JWT Authentication
JWT_SECRET_KEY="your-secure-random-jwt-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Groq API Configuration
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
MOCK_LLM_MODE=False
